<%- include("header") -%>
<div id="printHere">
    <div id="pPageContent">
        <div id="bill">
            <div id="pageWidth" class="container">
                <div class="row mt-5">
                    <div class="col-8">
                        <div class="coInfo text-start p-0 m-0 mt-5">
                            <img src="photos/Bravimotors no bg.png" alt="logo">
                        </div>
                    </div>
                    <div class="col-4">
                        <p class="m-0"><strong>Phone:</strong> +1 403 797-1870</p> 
                        <p class="m-0"><strong>Email:</strong> info@bavariamotors.ca</p>
                        <p id="invoiceNumberHTML" class="m-0 mt-3"><strong>Invoice:</strong><input id="invoiceNumber" type="text" placeholder="Invoice number" style="width:100%" required><input type="submit" onclick="invoiceNum()"></p>
                        <p id="invoiceDate" class="m-0"><strong>Invoice Date:</strong> <%=todayDate%></p>
                    </div>
                    
                </div>
                <section class="row">
                    <div class="col-8">
                        <div><p class="fw-medium">Bill to:</p></div>
                        <div id="customerInfo">
                            <form action="/" method="post" name="postCustomerInfo" id="customerInput">
                                <input type="text" id="customerName" placeholder="Name" name="customerName">
                                <br>
                                <input type="text" id="customerAddress" placeholder="Address" name="customerAddress">
                                <br>
                                <input type="number" id="customerPhone" placeholder="Phone" name="customerPhone">
                                <br>
                                <input type="email" id="customerEmail" placeholder="Email" name="customerEmail">
                                <br>
                                <input id="infoButton" type="submit">
                            </form>
                            <% for (let i = 0; i < customerInfotmationList.length; i++){ %>
                                <div>
                                    <p><%=  customerInfotmationList[i]  %></p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>
                <hr>
                <section id="description" class="mt-2">
                    <div id="carInfo">
                        <input id="car" type="text" placeholder="Car model" style="width:100%" required>
                    </div>
                    <table id="productsTable">
                        <thead>
                            <tr>
                                <th class="container ps-0">Description</th>
                                <th >Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody class="descriptionPart">
                            <tr id="partinfo1">
                                <td><input name="product1"  id="product1" type="text" placeholder="Product 1" style="width:100%"></td>
                                <td><input name="price1" id="price1" type="text" placeholder="$50.00"></td>
                                <td><input name="quantity1" id="quantity1" type="number" placeholder="2"></td>
                                <td><input name="total1" id="total1" type="text" placeholder="$100.00" disabled></td>
                            </tr>
                        </tbody>
                    </table>
                    <hr>
                    <div class="row">
                        <div class="col-12">
                            <div class="row">
                                <span class="col-8"></span>
                                <div class="col-4">
                                    <p id="subTotal" class="fw-medium ms-5 text-center"><%=totalCost%></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <span class="col-8"></span>
                                <div class="col-4">
                                    <p id="GST" class="fw-bold ms-5 text-center"><%=totalCost%></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <span class="col-8"></span>
                                <div class="col-4">
                                    <p id="totalCostHtml" class="fw-bold ms-5 text-center"><%=totalCost%></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button id="enterButton" onclick="replaceThePart()">Enter</button>
                    <button id="addButton" onclick="addProduct()">Add Product</button>
                </section>
            </div>
        </div>
    
<%- include("footer") -%>